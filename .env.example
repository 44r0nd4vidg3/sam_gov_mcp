# SAM.gov API Configuration
SAM_API_KEY=your_public_api_key_here
SAM_API_URL=https://api.sam.gov/opportunities/v2/search
SAM_API_ALPHA_URL=https://api-alpha.sam.gov/opportunities/v2/search
SAM_ENVIRONMENT=production
SAM_TIMEOUT=30
SAM_MAX_RETRIES=3

# MCP Server Configuration
# The server uses the stdio transport, so there is no host or port to set.
MCP_SERVER_DEBUG=False
MCP_SERVER_LOG_LEVEL=INFO

# Cache Configuration (optional)
CACHE_ENABLED=False
CACHE_TTL=3600
CACHE_TYPE=memory
